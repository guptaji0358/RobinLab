# Copy this file to `.dev.vars` and put your real token in it.
# `.dev.vars` is git-ignored, so the token is never committed.
#
# Create a token at https://huggingface.co/settings/tokens
# A read-only ("Read") token is enough for viewing the bucket.
HF_TOKEN=hf_your_token_here

# Signs the 30-minute share links handed out by POST /api/collection/share.
# Any long random string works, e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`.
# Optional: when it is missing, HF_TOKEN is used as the signing key instead.
SHARE_SECRET=change_me_to_a_long_random_string
